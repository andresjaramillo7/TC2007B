# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=grade_tracker

# JWT (Phase 2)
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=*

# Local HTTPS
HTTPS_PORT=3443
TLS_KEY_PATH=.local-certs/localhost-key.pem
TLS_CERT_PATH=.local-certs/localhost-cert.pem
